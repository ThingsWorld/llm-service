HOST=127.0.0.1
PORT=8000
API_KEY=replace-with-a-random-service-key
ADMIN_API_KEY=replace-with-an-independent-random-admin-key
KEY_HASH_SECRET=replace-with-at-least-32-random-bytes-and-keep-stable
DATA_DIR=.data
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_REVISION=a09a35458c702b33eeacc393d103063234e8bc28
BENCH_PROFILE=baseline
HF_HOME=/home/ubuntu/.cache/huggingface
# For local CPU only: ENGINE_BASE_URL must point to the externally started fixture.
# ENGINE_BASE_URL=http://127.0.0.1:30001
# BOOTSTRAP_PYTHON=/path/to/python3.12
# Optional GPU self-test provenance: self-managed, daytona, or unspecified.
# LLM_TEST_ENVIRONMENT=self-managed
# Optional numerical diagnostic, not a verified accuracy fix; default 0.
# FP32_LM_HEAD=1
# Optional one-factor numerical controls; require explicit compatible backend.
# ATTENTION_BACKEND=triton
# TRITON_ATTENTION_REDUCE_IN_FP32=1
# DETERMINISTIC_INFERENCE=1
